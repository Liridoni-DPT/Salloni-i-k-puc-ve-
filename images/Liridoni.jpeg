<!-- Produkti 3: Sandale Verore me Llastik -->
<div class="product-card">
    <img src="images/Liridoni.jpeg" alt="Sandale Verore me Llastik">
    <h4>Sandale Verore me Llastik (Bezhë & E zezë)</h4>
    <div class="order-form">
        <label>Numri:</label>
        <select class="shoe-size">
            <option value="36">36</option>
            <option value="37">37</option>
            <option value="38">38</option>
            <option value="39">39</option>
            <option value="40">40</option>
        </select>
        <label>Emri dhe Mbiemri:</label>
        <input type="text" class="customer-name" placeholder="Shkruani emrin...">
        <label>Adresa:</label>
        <input type="text" class="customer-address" placeholder="Qyteti, Rruga...">
        <button class="order-btn" onclick="sendOrder(this, 'Sandale Verore me Llastik')">Porosit në WhatsApp</button>
    </div>
</div>

